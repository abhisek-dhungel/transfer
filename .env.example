# .env.example
# MySQL connection URL (e.g. mysql://user:pass@host:3306/dbname)
DATABASE_URL=

# Direct URL for Prisma migration (optional for certain providers)
DIRECT_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=transfer@techsastra.com

# Application URL (public URL when deployed)
NEXT_PUBLIC_APP_URL=https://send.techsastra.com

# Limits
MAX_FILE_SIZE_MB=100
TRANSFER_EXPIRY_DAYS=7

# Rate limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600
